      "score": "2:2",
      "minute": 77,
      "minute_additional": null,
      "likes": 0,
      "ad": null,
      "timestamp": "2024-08-18T16:40:08.000+0000"
    },
    {
      "id": "02QFMK3FA4000000VS5489B5VTLI5MJU",
      "type_id": 2,
      "description": "Gelbe Karte für Kai Christian Morbach (8)",
      "comment": "Schiri windet sich mit einer widersprüchlichen Begründung raus und verzettelt sich immer mehr. Der Spieler wird von hinten gefällt und bekommt selbst Gelb. Das ist aber auch mal schwer zu rechtfertigen. Klar dass der Schiri da in Erklärungsnot kommt. Sehr merkwürdig.",
      "team_id": "02QFLUNNCO000001VS5489B5VTLI5MJU",
      "member_id": "02QFLUNNEO000006VS5489B5VTLI5MJU",
      "member2_id": "",
